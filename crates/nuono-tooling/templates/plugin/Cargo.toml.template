[package]
name = "{{package_name}}"
version = "0.1.0"
edition = "2024"
publish = false

[workspace]

[lib]
crate-type = ["rlib"]

[dependencies]
nuono-plugin = { path = "../../crates/nuono-plugin" }

[dev-dependencies]
nuono-plugin-test = { path = "../../crates/nuono-plugin-test" }
tokio = { version = "1", features = ["rt", "macros"] }

[profile.dev]
debug = 0
incremental = true

[profile.release]
debug = 0
incremental = true
lto = false
codegen-units = 16
